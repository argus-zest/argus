{
  "title": "HazardAnalysis",
  "type": "object",
  "required": [
    "hazard_type",
    "severity",
    "submerged",
    "confidence",
    "description",
    "visible_evidence"
  ],
  "properties": {
    "hazard_type": {
      "type": "string",
      "enum": [
        "pothole",
        "open_manhole",
        "missing_drain_cover",
        "waterlogging",
        "none",
        "unclear"
      ]
    },
    "severity": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "submerged": {
      "type": "boolean"
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "description": {
      "type": "string",
      "maxLength": 200
    },
    "visible_evidence": {
      "type": "string",
      "maxLength": 200
    }
  }
}
