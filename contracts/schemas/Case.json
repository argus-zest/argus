{
  "title": "Case",
  "type": "object",
  "required": [
    "case_id",
    "lat",
    "lng",
    "status",
    "rung",
    "owner",
    "jurisdiction",
    "warranty",
    "dry_run",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^CS-[A-Z0-9]{6}$"
    },
    "hotspot_id": {
      "type": "string",
      "nullable": true
    },
    "asset_id": {
      "type": "string",
      "nullable": true
    },
    "lat": {
      "type": "number"
    },
    "lng": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "OPEN",
        "AWAITING_FIX",
        "FIX_CLAIMED",
        "CLOSED_VERIFIED",
        "ESCALATED_DM",
        "UNRESOLVED_FINAL"
      ]
    },
    "rung": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "owner": {
      "type": "string",
      "enum": ["NHAI", "NDMC", "PWD", "DJB", "MCD", "ORPHAN"]
    },
    "jurisdiction": {
      "$ref": "./Jurisdiction.json"
    },
    "warranty": {
      "$ref": "./Warranty.json"
    },
    "analysis": {
      "$ref": "./HazardAnalysis.json"
    },
    "photo_key": {
      "type": "string",
      "nullable": true
    },
    "execution_arn": {
      "type": "string",
      "nullable": true
    },
    "timer_profile": {
      "type": "string",
      "enum": ["demo", "real"]
    },
    "dry_run": {
      "type": "boolean"
    },
    "seeded": {
      "type": "boolean"
    },
    "demo_run": {
      "type": "boolean"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
