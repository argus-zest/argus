# WaterWatch Delhi - Environment Variables Example
# Copy to .env or .env.local for local development. Never commit real keys.

# AWS & Regions
AWS_REGION=ap-southeast-2
AWS_PROFILE=hackathon
# Set only after independently verifying hackathon STS identity; required by deploy.sh
EXPECTED_AWS_ACCOUNT_ID=

# Amazon Location Service
VITE_LOCATION_API_KEY=your_location_api_key_here
LOCATION_API_KEY=your_location_api_key_here

# API Gateway Endpoint
VITE_API_BASE=http://localhost:3000/v1
VITE_AWS_REGION=ap-southeast-2

# Optional Mock Mode (Local Development)
# Backend inference fixtures require USE_MOCKS=true AND ARGUS_ENV=local.
# They do not mock storage, persistence, workflow execution, or email.
# Frontend mocks require Vite development mode and are read-only.
ARGUS_ENV=local
VITE_USE_MOCKS=false
USE_MOCKS=false

# SES Configuration (Sandbox) — placeholders only; verify owned identities before deployment
SES_FROM=verified_identity@example.com
DRYRUN_INBOX=verified_identity@example.com

# Bedrock Model
NOVA_MODEL_ID=amazon.nova-lite-v1:0

# Optional TomTom Traffic
ENABLE_TOMTOM=false
TOMTOM_API_KEY=
